        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    var score = parseFloat(current.overall_readiness);

    if (isNaN(score)) {
        current.readiness_tier = '';
        return;
    }

    if (score >= 80) {
        current.readiness_tier = 'Ready(>=80)';
    } 
    else if (score >= 50) {
        current.readiness_tier = 'Partially Ready(50-79)';
    } 
    else {
        current.readiness_tier = 'Not Ready(<50)';
    } 

})(current, previous);]]></script>
