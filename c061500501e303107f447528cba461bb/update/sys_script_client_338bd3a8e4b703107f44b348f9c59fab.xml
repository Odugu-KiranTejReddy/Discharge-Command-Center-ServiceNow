        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Assigns Readiness Tier</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {

    if (isLoading) {
        return;
    }

    var score = parseFloat(newValue);

    if (isNaN(score)) {
        g_form.setValue('readiness_tier', '');
        return;
    }

    if (score >= 80) {
        g_form.setValue('readiness_tier', 'Ready(>=80)');
    } 
    else if (score >=50 && score<=79) {
        g_form.setValue('readiness_tier', 'Partially Ready(50-79)');
    } 
    else if (score<=49){
        g_form.setValue('readiness_tier', 'Not Ready(<50)');
    } 
}]]></script>
